# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API). EXPO_PUBLIC_* values are bundled into the client,
# so only put PUBLIC values here (never the service_role / secret key).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Only Google accounts on this domain may sign in. Must match the value in
# supabase/schema.sql -> public.allowed_email_domain().
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=hbplus.fit
